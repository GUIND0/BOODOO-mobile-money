{
  "paths": {
    "/internal/v1/accounts/{id}/control": {
      "post": {
        "operationId": "changeAccountControl",
        "summary": "changeAccountControl",
        "description": "Requires ledger:controls:write. Signed operator. CLOSED requires a frozen empty account and cannot reopen.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted response; inspect status/state for pending financial operations"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Missing scope or signed actor authority"
          },
          "404": {
            "description": "Unknown or foreign resource"
          },
          "409": {
            "description": "State, identity or idempotency conflict"
          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "state",
                  "expectedVersion",
                  "reasonCode"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "OPEN",
                      "FROZEN",
                      "CLOSED"
                    ]
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "reasonCode": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "readAccountControl",
        "summary": "readAccountControl",
        "description": "Requires ledger:controls:read. ",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted response; inspect status/state for pending financial operations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accountId",
                    "state",
                    "version"
                  ],
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "OPEN",
                        "FROZEN",
                        "CLOSED"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Missing scope or signed actor authority"
          },
          "404": {
            "description": "Unknown or foreign resource"
          },
          "409": {
            "description": "State, identity or idempotency conflict"
          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        }
      }
    }
  },
  "openapi": "3.1.0",
  "info": {
    "title": "BOODOO ledger-service wallet-operational-controls",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
