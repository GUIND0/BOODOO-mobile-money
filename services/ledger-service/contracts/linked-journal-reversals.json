{
  "paths": {
    "/internal/v1/journals/{original}/reversal": {
      "post": {
        "operationId": "requestLinkedReversal",
        "summary": "requestLinkedReversal",
        "description": "Requires ledger:reversals:request. Signed operator; generic reversals exclude physical cash settlement. A different operator must approve.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "original",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Accepted response; inspect status/state for pending financial operations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "originalJournalId",
                    "reasonCode",
                    "requestedBy"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "originalJournalId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "reasonCode": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                    },
                    "requestedBy": {
                      "type": "string"
                    },
                    "approvedBy": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "compensatingJournalId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Missing scope or signed actor authority"
          },
          "404": {
            "description": "Unknown or foreign resource"
          },
          "409": {
            "description": "State, identity or idempotency conflict"
          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reasonCode"
                ],
                "properties": {
                  "reasonCode": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                  }
                }
              }
            }
          }
        }
      }
    },
