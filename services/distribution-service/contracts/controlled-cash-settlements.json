{
  "paths": {
    "/internal/v1/cash-operations": {
      "post": {
        "operationId": "requestControlledCash",
        "summary": "requestControlledCash",
        "description": "Requires cash:request. Signed operator; OUT requires PIN. Evidence is a manual assertion, not automatic provider attestation. Requires explicitly enabled zero-fee policy.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Accepted response; inspect status/state for pending financial operations"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Missing scope or signed actor authority"
          },
          "404": {
            "description": "Unknown or foreign resource"
          },
          "409": {
            "description": "State, identity or idempotency conflict"
          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "walletId",
                  "direction",
                  "amount",
                  "evidence"
                ],
                "properties": {
                  "walletId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "IN",
                      "OUT"
                    ]
                  },
                  "amount": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "evidence": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "pin": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/cash-operations/{id}/approval": {
      "post": {
        "operationId": "approveControlledCash",
        "summary": "approveControlledCash",
        "description": "Requires cash:approve. Different signed operator. Retry this endpoint to recover uncertain accounting; 202 is pending.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted response; inspect status/state for pending financial operations"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid authentication"
          },
          "403": {
            "description": "Missing scope or signed actor authority"
          },
          "404": {
            "description": "Unknown or foreign resource"
          },
          "409": {
            "description": "State, identity or idempotency conflict"
          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        }
      }
    },
    "/internal/v1/cash-operations/{id}": {
      "get": {
        "operationId": "readControlledCash",
        "summary": "readControlledCash",
        "description": "Requires cash:read. Signed operator.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
