          },
          "503": {
            "description": "Unknown/dependency outcome; retry the same identifier"
          }
        }
      }
    },
    "/internal/v1/cash-operations/{id}/disbursement": {
      "post": {
        "operationId": "acknowledgeCashDisbursement",
        "summary": "acknowledgeCashDisbursement",
        "description": "Requires cash:disburse. Original cashier; OUT only and accounting must already be confirmed. Separate physical acknowledgement.",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
